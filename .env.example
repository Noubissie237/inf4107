# Development values only. Copy to .env (never commit .env).

# PostgreSQL (used by compose to create the instance and build DATABASE_URL)
POSTGRES_USER=app
POSTGRES_PASSWORD=dev-password-change-me

# Shared JWT secret (at least 32 characters)
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef

# Student matricule returned by /health
INSTANCE_ID=local

# Password given to all seeded accounts
SEED_PASSWORD=dev-seed-password

# S3 mode with the local MinIO (profile "s3"): uncomment these lines, then run
#   docker compose --profile s3 up -d
# STORAGE_BACKEND=s3
# S3_BUCKET=photos
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=http://minio:9000
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# In real AWS: no endpoint and no keys, the IAM role is used.

# Optional settings (defaults shown)
# JWT_EXPIRE_MINUTES=60
# CORS_ORIGINS=http://localhost:8080,http://localhost:3000
# LOG_LEVEL=INFO
# DB_POOL_SIZE=5
# RUN_MIGRATIONS=true
# STORAGE_LOCAL_DIR=/data/photos
# GRADE_WEIGHTS=0.3,0.2,0.5
