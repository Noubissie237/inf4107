# --- Base de donnees (RDS) ---
DB_HOST=inf4107-db.xxxxxxxx.eu-west-3.rds.amazonaws.com
DB_USER=postgres
DB_PASSWORD=<mot de passe RDS, lettres et chiffres uniquement>

# --- Secrets applicatifs ---
JWT_SECRET=<40 caracteres aleatoires, identique pour les 2 services>
SEED_PASSWORD=<mot de passe des etudiants fictifs>

# --- Stockage des photos (S3) ---
STORAGE_BACKEND=s3
S3_BUCKET=<nom-du-bucket>
S3_REGION=eu-west-3
# NE PAS definir : S3_ENDPOINT_URL, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
# (le role IAM de l'EC2 fournit les acces)

# --- Demarrage ---
RUN_MIGRATIONS=true
BCRYPT_ROUNDS=10
